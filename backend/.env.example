# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/dhikshith-portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dhikshith-portfolio
MONGO_URI=mongodb://127.0.0.1:27017/dhikshith-portfolio

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (Nodemailer with Gmail)
# 1. Go to your Google Account → Security → 2-Step Verification → App Passwords
# 2. Generate an App Password for "Mail"
# 3. Paste the 16-char password below (NOT your regular Gmail password)
EMAIL_SERVICE=gmail
EMAIL_USER=deekshithramposhala@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_TO=deekshithramposhala@gmail.com
